#!/usr/bin/env sh

# Fail loudly if Laravel's storage skeleton is not tracked in git.
#
# git cannot store an empty directory, so the storage tree only survives a clone
# because the scaffold commits a .gitignore marker inside each one. A missing
# marker means a clone gets no storage tree at all and every artisan command dies
# with "Please provide a valid cache path." - and because .gitignore never
# untracks, a repo with a blanket /storage rule looks healthy indefinitely.
#
# git ls-files reads the index, so staging the markers satisfies this check.
if [ -f artisan ] && ! git ls-files --error-unmatch storage/framework/views/.gitignore >/dev/null 2>&1; then
  echo "✗ Laravel's storage skeleton is not tracked in git."
  echo "  A clone of this repo gets no storage tree and artisan will fail to boot."
  echo
  echo "  Check .gitignore does not blanket-ignore /storage, then:"
  echo "    mkdir -p storage/framework/{cache/data,sessions,testing,views} storage/app/{private,public} storage/logs"
  echo "  add the ten marker files, and commit them."
  exit 1
fi

lint-staged
