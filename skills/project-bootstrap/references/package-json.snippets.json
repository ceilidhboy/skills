// Merge into the project package.json (scripts + lint-staged block + devDependencies).

"scripts": {
    "prepare": "husky",
    "lint": "biome check . --write",
    "lint:check": "biome ci .",
    "types": "tsc --noEmit",
    "checks": "npm run lint:check && npm run types"
}

"lint-staged": {
    "*.php": "vendor/bin/pint",
    "*.{ts,tsx,js,jsx,mjs,cjs,css,json}": "biome check --write"
}

"devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0"
}